# Copy this file to .env and fill in your values. Never commit .env.
# DagsHub: repo page -> Remote -> Experiments shows the tracking URI.
MLFLOW_TRACKING_URI=https://dagshub.com/<dagshub_user>/<repo_name>.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub_user>
# DagsHub: User settings -> Tokens
MLFLOW_TRACKING_PASSWORD=<dagshub_token>
